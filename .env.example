# ------------------------------------------------------------------
# Arihant Workspace - environment template (development defaults).
# Copy to server/.env. NEVER commit real secrets.
# ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
ORG_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# MongoDB (replica set required for transactions)
MONGO_URI=mongodb://localhost:27017/arihant_workspace?replicaSet=rs0&directConnection=true

# Redis (BullMQ, Socket.IO adapter, rate limiting, locks)
REDIS_URL=redis://localhost:6380

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Secure cookies need HTTPS; defaults to true outside development/test.
# COOKIE_SECURE=true
# Public URL of the web app, used in e-mailed links (defaults to the first APP_ORIGIN).
# PUBLIC_APP_URL=https://workspace.arihant.local
AUTH_RATE_LIMIT_MAX=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_HOURS=72

# Object storage (any S3-compatible store; SeaweedFS in development)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=arihant-workspace
S3_ACCESS_KEY=arihant
S3_SECRET_KEY=arihant-dev-secret
S3_FORCE_PATH_STYLE=true

# Mail (Mailpit in development: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Arihant Workspace <no-reply@arihant.local>"

# AI (Phase 7) - leave empty to keep AI features disabled
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Claude model for the AI assistant. AI stays off until an administrator enables it in Settings.
AI_MODEL=claude-opus-5-5

# First Super Admin (used only by: npm run seed:admin -w server). Do not keep real values in files.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_EMPLOYEE_ID=ADMIN-001
# SEED_ADMIN_PASSWORD=

# Git integration: secret shared with the GitHub webhook (leave empty to keep it off)
GITHUB_WEBHOOK_SECRET=

# GitLab / Bitbucket webhooks (same repository list as GitHub; leave empty to keep them off)
GITLAB_WEBHOOK_SECRET=
BITBUCKET_WEBHOOK_SECRET=

# Encrypts stored secrets (two-step verification). 32 random bytes in base64, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# When empty a key is derived from JWT_ACCESS_SECRET.
DATA_ENCRYPTION_KEY=

# Single sign-on with OpenID Connect (Microsoft Entra ID, Google Workspace, Okta…). Leave empty to keep it off.
# Register the redirect URI <public app URL>/api/v1/auth/sso/callback with the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Microsoft
OIDC_REDIRECT_URI=
